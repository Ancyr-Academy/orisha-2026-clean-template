{% extends 'base.html.twig' %}

{% set title = patient_id ? 'Edit patient' : 'New patient' %}

{% block title %}{{ title }} · Acme{% endblock %}

{% block body %}
    <article class="narrow">
        <header>
            <h1>{{ title }}</h1>
        </header>

        {% if error %}
            <p role="alert">{{ error }}</p>
        {% endif %}

        <form method="post" action="{{ patient_id ? '/patients/' ~ patient_id : '/patients' }}">
            {% if patient_id %}
                <input type="hidden" name="_METHOD" value="PUT">
            {% endif %}
            <div class="grid">
                <label>
                    First name
                    <input type="text" name="first_name" value="{{ form.first_name }}" required
                           maxlength="{{ maximum_name_length }}" autocomplete="off">
                </label>
                <label>
                    Last name
                    <input type="text" name="last_name" value="{{ form.last_name }}" required
                           maxlength="{{ maximum_name_length }}" autocomplete="off">
                </label>
            </div>
            <label>
                Gender
                <select name="gender" required>
                    <option value="" disabled {{ form.gender in genders ? '' : 'selected' }}>Select…</option>
                    {% for gender in genders %}
                        <option value="{{ gender }}" {{ form.gender == gender ? 'selected' }}>{{ gender|capitalize }}</option>
                    {% endfor %}
                </select>
            </label>
            <label>
                Birth date
                <input type="date" name="birth_date" value="{{ form.birth_date }}" required max="{{ today }}">
            </label>
            <div class="form-actions">
                <a href="/patients" role="button" class="secondary outline">Cancel</a>
                <button type="submit">{{ patient_id ? 'Save changes' : 'Add patient' }}</button>
            </div>
        </form>
    </article>
{% endblock %}
