<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <title>{% block title %}Acme{% endblock %}</title>
    <link rel="icon" href="data:,">
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/@picocss/pico@2.1.1/css/pico.min.css"
          integrity="sha384-L1dWfspMTHU/ApYnFiMz2QID/PlP1xCW9visvBdbEkOLkSSWsP6ZJWhPw6apiXxU"
          crossorigin="anonymous">
    <style>
        .narrow { max-width: 28rem; margin-inline: auto; }
        nav { gap: var(--pico-nav-element-spacing-horizontal); }
        nav ul, nav .account { min-width: 0; }
        nav .account small { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        nav form { margin: 0; }
        /* Pico's [type=submit] rule outranks its own nav button sizing: re-apply it to the logout button */
        nav form [type="submit"] {
            margin: 0;
            white-space: nowrap;
            padding: calc(var(--pico-nav-link-spacing-vertical) - var(--pico-border-width) * 2) var(--pico-nav-link-spacing-horizontal);
        }
        [role="alert"] { color: var(--pico-del-color); }
        .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
        .page-heading { display: flex; flex-wrap: wrap; gap: var(--pico-spacing); align-items: center; justify-content: space-between; margin-bottom: var(--pico-spacing); }
        .page-heading h1 { margin: 0; }
        .empty-state { text-align: center; }
        .form-actions { display: flex; gap: var(--pico-spacing); justify-content: flex-end; }
        .form-actions > * { margin: 0; width: auto; }
        /* Keep table rows on one line: narrow screens scroll the table horizontally instead */
        .overflow-auto { position: relative; }
        .overflow-auto th, .overflow-auto td { white-space: nowrap; }
        .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr)); gap: var(--pico-spacing); }
        .cards > article { margin: 0; display: flex; flex-direction: column; }
        .cards > article > footer { margin-top: auto; }
        .cards header { display: flex; justify-content: space-between; align-items: baseline; gap: var(--pico-spacing); }
        .occupants { padding: 0; }
        .occupants li { list-style: none; display: flex; justify-content: space-between; align-items: center; gap: var(--pico-spacing); }
        .occupants form, .cards footer form, .cards footer fieldset { margin: 0; }
        .occupants [type="submit"] { margin: 0; width: auto; padding: 0.25rem 0.75rem; }
        .cards [role="group"] [type="submit"] { flex: 0 0 auto; width: auto; padding-inline: 1rem; }
        /* Phones lack room for the account email next to the links */
        @media (max-width: 575px) { nav .account { display: none; } }
        .row-actions { display: flex; gap: var(--pico-spacing); align-items: center; justify-content: flex-end; }
        .row-actions form { margin: 0; }
        .row-actions [type="submit"] { margin: 0; width: auto; padding: 0.25rem 0.75rem; }
    </style>
    <script>
        // Asks for confirmation before submitting a form flagged with data-confirm (e.g. a deletion)
        document.addEventListener('submit', (event) => {
            const message = event.target.dataset.confirm;
            if (message && !confirm(message)) {
                event.preventDefault();
            }
        });
    </script>
</head>
<body>
    {% set account = session.get('account') %}
    <header class="container">
        <nav>
            <ul>
                <li><a href="/" class="contrast"><strong>Acme</strong></a></li>
            </ul>
            <ul>
                {% if account %}
                    <li><a href="/patients">Patients</a></li>
                    <li><a href="/rooms">Rooms</a></li>
                    <li class="account"><small title="{{ account.email }}">Logged in as {{ account.email }}</small></li>
                    <li>
                        <form method="post" action="/logout">
                            <button type="submit" class="secondary outline">Log out</button>
                        </form>
                    </li>
                {% else %}
                    <li><a href="/login">Log in</a></li>
                    <li><a href="/register" role="button">Register</a></li>
                {% endif %}
            </ul>
        </nav>
    </header>

    <main class="container">
        {% block body %}{% endblock %}
    </main>
</body>
</html>
