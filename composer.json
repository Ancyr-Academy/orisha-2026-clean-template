{
    "name": "acme/acme",
    "description": "Acme - a minimal Clean Architecture application with Slim, Twig and Doctrine",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "doctrine/dbal": "^4.5",
        "doctrine/migrations": "^3.9",
        "doctrine/orm": "^3.7",
        "php-di/php-di": "^7.1",
        "slim/psr7": "^1.8",
        "slim/slim": "^4.15",
        "slim/twig-view": "^3.4",
        "symfony/cache": "^8.1",
        "symfony/uid": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Acme\\": "src/"
        },
        "exclude-from-classmap": [
            "src/Tests/"
        ]
    },
    "repositories": {
        "packagist.org": {
            "type": "composer",
            "url": "https://repo.packagist.org"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "serve": "php -S localhost:8000 -t public",
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration"
    }
}
